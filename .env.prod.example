# =============================================================================
# Accessible Path - PRODUCTION environment (Beget)
# =============================================================================
# Copy to .env.prod and fill in REAL values. Never commit .env.prod to git!
#   cp .env.prod.example .env.prod
#
# Beget panels you need first:
#   - VPS: public IP, SSH access, Docker installed (see DEPLOY.md)
#   - Managed PostgreSQL: create 6 databases + 6 users (see DEPLOY.md -> SQL)
#   - S3: create bucket "barrier-photos", generate access keys
#   - DNS: A-record of your domain -> VPS IP
# =============================================================================

# -----------------------------------------------------------------------------
# Domain / TLS (leave DOMAIN empty to skip Let's Encrypt)
# -----------------------------------------------------------------------------
DOMAIN=your-domain.ru
CERTBOT_EMAIL=admin@your-domain.ru

# -----------------------------------------------------------------------------
# Managed PostgreSQL (Beget) - shared host/port, per-service databases
# -----------------------------------------------------------------------------
POSTGRES_HOST=pg1234567-beget.app
POSTGRES_PORT=5432
# "disable" if Beget allows plain connections, otherwise "require"
POSTGRES_SSLMODE=disable

AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me-strong-1

BARRIER_DB_NAME=barrier_db
BARRIER_DB_USER=barrier_user
BARRIER_DB_PASSWORD=change-me-strong-2

MODERATION_DB_NAME=moderation_db
MODERATION_DB_USER=moderation_user
MODERATION_DB_PASSWORD=change-me-strong-3

ROUTE_DB_NAME=route_db
ROUTE_DB_USER=route_user
ROUTE_DB_PASSWORD=change-me-strong-4

POI_DB_NAME=poi_db
POI_DB_USER=poi_user
POI_DB_PASSWORD=change-me-strong-5

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=change-me-strong-6

# -----------------------------------------------------------------------------
# Redis (local container, set a strong password)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change-me-strong-redis
REDIS_DB=0

# -----------------------------------------------------------------------------
# S3 (Beget managed S3)
#   - create the bucket "barrier-photos" in the Beget panel
#   - endpoint WITHOUT scheme, e.g. s3.ru1.storage.beget.cloud
#   - MINIO_PUBLIC_URL = public endpoint used in presigned photo links
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=s3.ru1.storage.beget.cloud
MINIO_PUBLIC_URL=https://s3.ru1.storage.beget.cloud
MINIO_ACCESS_KEY=change-me-s3-access-key
MINIO_SECRET_KEY=change-me-s3-secret-key
MINIO_BUCKET=barrier-photos
MINIO_USE_SSL=true
S3_REGION=ru-1
S3_ADDRESSING_STYLE=path

# -----------------------------------------------------------------------------
# JWT (RS256). Keys are generated by deploy.sh into services/auth-service/keys/
# -----------------------------------------------------------------------------
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12

# -----------------------------------------------------------------------------
# Seeded moderator (created on first auth-service start)
# -----------------------------------------------------------------------------
SEED_MODERATOR_EMAIL=moderator@your-domain.ru
SEED_MODERATOR_PASSWORD=change-me-moderator-password

# -----------------------------------------------------------------------------
# Redis Streams (event bus) - keep defaults unless you know why to change
# -----------------------------------------------------------------------------
STREAM_BARRIER_CREATED=barrier.created
STREAM_BARRIER_APPROVED=barrier.approved
STREAM_BARRIER_REJECTED=barrier.rejected
STREAM_BARRIER_RESOLVED=barrier.resolved
CONSUMER_GROUP_MODERATION=moderation-group
CONSUMER_GROUP_NOTIFICATION=notification-group

# -----------------------------------------------------------------------------
# OpenStreetMap (route graph import on first start)
# -----------------------------------------------------------------------------
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_DEFAULT_BBOX=55.7000,37.5200,55.8000,37.7200

# -----------------------------------------------------------------------------
# Service ports (internal, not published to the internet)
# -----------------------------------------------------------------------------
AUTH_SERVICE_PORT=8081
BARRIER_SERVICE_PORT=8000
MODERATION_SERVICE_PORT=8001
ROUTE_SERVICE_PORT=8082
POI_SERVICE_PORT=8002
NOTIFICATION_SERVICE_PORT=8083

# -----------------------------------------------------------------------------
# Frontend (same-origin API via nginx, keep /api)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api
