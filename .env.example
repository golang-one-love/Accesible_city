# =============================================================================
# Accessible Path - Environment Variables
# =============================================================================
# Copy to .env and adjust for your environment. Never commit .env to git!
# Dev defaults below match infra/postgres/init.sql (per-service DBs and roles).

# -----------------------------------------------------------------------------
# PostgreSQL (main superuser)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Per-service databases and roles (created by init.sql, one DB per service)
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass

BARRIER_DB_NAME=barrier_db
BARRIER_DB_USER=barrier_user
BARRIER_DB_PASSWORD=barrier_pass

MODERATION_DB_NAME=moderation_db
MODERATION_DB_USER=moderation_user
MODERATION_DB_PASSWORD=moderation_pass

ROUTE_DB_NAME=route_db
ROUTE_DB_USER=route_user
ROUTE_DB_PASSWORD=route_pass

POI_DB_NAME=poi_db
POI_DB_USER=poi_user
POI_DB_PASSWORD=poi_pass

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=notification_pass

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# MinIO (S3-compatible photo storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=barrier-photos
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# -----------------------------------------------------------------------------
# JWT (RS256 - private key only in auth-service, public key shared)
# Generate with:  docker run --rm -v "${PWD}:/src" -w /src golang:1.22-alpine go run generate_keys.go
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_ISSUER=accessible-path
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12

# -----------------------------------------------------------------------------
# Redis Streams (event bus)
# -----------------------------------------------------------------------------
STREAM_BARRIER_CREATED=barrier.created
STREAM_BARRIER_APPROVED=barrier.approved
STREAM_BARRIER_REJECTED=barrier.rejected
STREAM_BARRIER_RESOLVED=barrier.resolved
CONSUMER_GROUP_MODERATION=moderation-group
CONSUMER_GROUP_NOTIFICATION=notification-group

# -----------------------------------------------------------------------------
# OpenStreetMap (route graph)
# -----------------------------------------------------------------------------
OSM_API_URL=https://api.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_DEFAULT_BBOX=55.7000,37.5200,55.8000,37.7200

# -----------------------------------------------------------------------------
# Auth Service (Go) - port 8081
# -----------------------------------------------------------------------------
AUTH_SERVICE_PORT=8081
AUTH_SERVICE_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Barrier Service (Python/FastAPI) - port 8000
# -----------------------------------------------------------------------------
BARRIER_SERVICE_PORT=8000
BARRIER_SERVICE_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Moderation Service (Python/FastAPI) - port 8001
# -----------------------------------------------------------------------------
MODERATION_SERVICE_PORT=8001
MODERATION_SERVICE_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Route Service (Go) - port 8082
# -----------------------------------------------------------------------------
ROUTE_SERVICE_PORT=8082
ROUTE_SERVICE_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# POI Service (Python/FastAPI) - port 8002
# -----------------------------------------------------------------------------
POI_SERVICE_PORT=8002
POI_SERVICE_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Notification Service (Go) - port 8083
# -----------------------------------------------------------------------------
NOTIFICATION_SERVICE_PORT=8083
NOTIFICATION_SERVICE_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api

# -----------------------------------------------------------------------------
# Nginx - ports 80/443
# -----------------------------------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost